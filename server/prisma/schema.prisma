generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  companyId Int        @id @default(autoincrement())
  name      String     @unique
  users     User[]
  teams     Team[]
  taskLists TaskList[]
  tasks     Task[]
  auditLogs AuditLog[]

  @@map(name: "company")
}

model User {
  userId    Int        @id @default(autoincrement())
  company   Company    @relation(fields: [companyId], references: [companyId])
  companyId Int
  firstName String
  lastName  String
  email     String     @unique
  password  String
  role      UserRole
  taskLists TaskList[]
  team      Team       @relation(fields: [teamId], references: [teamId])
  teamId    Int
  tasks     Task[]
  auditLogs AuditLog[]

  @@map(name: "user")
}

model Team {
  teamId    Int        @id @default(autoincrement())
  company   Company    @relation(fields: [companyId], references: [companyId])
  companyId Int
  name      String     @unique
  members   User[]
  taskLists TaskList[]
  tasks     Task[]

  @@map(name: "team")
}

model TaskList {
  taskListId   Int      @id @default(autoincrement())
  company      Company  @relation(fields: [companyId], references: [companyId])
  companyId    Int
  user         User     @relation(fields: [userId], references: [userId])
  userId       Int
  team         Team     @relation(fields: [teamId], references: [teamId])
  teamId       Int
  taskListDate DateTime @db.Date
  tasks        Task[]

  @@map(name: "task_list")
}

model Task {
  taskId        Int        @id @default(autoincrement())
  company       Company    @relation(fields: [companyId], references: [companyId])
  companyId     Int
  taskList      TaskList   @relation(fields: [taskListId], references: [taskListId])
  taskListId    Int
  user          User       @relation(fields: [userId], references: [userId])
  userId        Int
  team          Team       @relation(fields: [teamId], references: [teamId])
  teamId        Int
  title         String
  notes         String?
  status        TaskStatus @default(PENDING)
  private       Boolean
  hoursEstimate Int?
  createdAt     DateTime   @default(now())

  @@map(name: "task")
}

model AuditLog {
  auditLogId Int            @id @default(autoincrement())
  company    Company        @relation(fields: [companyId], references: [companyId])
  companyId  Int
  user       User           @relation(fields: [userId], references: [userId])
  userId     Int
  action     AuditLogAction
  target     AuditLogTarget
  sourceIp   String
  timestamp  DateTime       @default(now())

  @@map(name: "audit_log")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
  NEED_HELP
}

enum UserRole {
  DEVELOPER
  MANAGER
  COMPANY_ADMIN
  ADMIN
}

enum AuditLogAction {
  READ
  UPDATE
  CREATE
  DELETE
  LOGIN
  LOGOUT
}

enum AuditLogTarget {
  COMPANY
  USER
  TEAM
  TASK_LIST
  TASK
}
